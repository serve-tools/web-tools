{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2025", "DOM"],
		"outDir": "dist",
		"rootDir": "src",
		"module": "es2022",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2025",
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/.*.ts"],
	"references": [
		{
			"path": "../tsconfig.json"
		}
	]
}
