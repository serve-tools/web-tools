{
	"name": "@serve-tools/lit-signals",
	"version": "0.3.1",
	"description": "Signal-native Lit templates, styles, directives, and decorators",
	"keywords": [
		"computed",
		"css",
		"context",
		"decorator",
		"directive",
		"effect",
		"lit",
		"property",
		"reactive",
		"ref",
		"repeat",
		"signal",
		"style",
		"stylesheet",
		"svg",
		"tc39",
		"template",
		"web-components"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/lit/signals#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "lit/signals"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/lit-signals.js",
		"./decorators": "./dist/decorators.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/client-context --workspace @serve-tools/signal --workspace @serve-tools/signal-collections --workspace @serve-tools/signal-event-target",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.browser.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/client-context": "^0.1",
		"@serve-tools/signal": "^0.1",
		"@serve-tools/signal-collections": "^0.1",
		"@serve-tools/signal-event-target": "^0.1"
	},
	"devDependencies": {
		"@lit/context": "1.1.6",
		"lit": "3.3.3"
	},
	"peerDependencies": {
		"lit": "^3"
	}
}
