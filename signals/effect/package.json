{
	"name": "@serve-tools/signal-effect",
	"version": "0.1.2",
	"description": "Microtask-batched effects for TC39 Signals",
	"keywords": [
		"effect",
		"reactive",
		"reactivity",
		"scheduler",
		"signal",
		"tc39",
		"watcher"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/signals/effect#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "signals/effect"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/signal-effect.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/signal",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "npm run build:dependencies && vitest run --config vitest.browser.config.ts",
		"test:node": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/signal": "^0.1"
	}
}
