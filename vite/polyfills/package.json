{
	"name": "@serve-tools/vite-polyfills",
	"version": "0.2.0",
	"description": "Detects and injects polyfills for unsupported JavaScript features in Vite",
	"keywords": [
		"browser-compatibility",
		"cancel-idle-callback",
		"explicit-resource-management",
		"feature-detection",
		"get-or-insert-computed",
		"get-or-insert",
		"getorinsert",
		"getorinsertcomputed",
		"map-upsert",
		"polyfill",
		"prioritized-task-scheduling",
		"request-idle-callback",
		"scheduler-post-task",
		"scheduler-yield",
		"scheduler",
		"scheduling",
		"symbol-metadata",
		"task-controller",
		"task-priority-change-event",
		"task-signal",
		"upsert",
		"urlpattern",
		"vite",
		"vite-plugin"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/vite/polyfills#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "vite/polyfills"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/vite-polyfills.js",
		"./types": "./dist/types/index.d.ts",
		"./types/map-upsert": "./dist/types/map-upsert.d.ts",
		"./types/symbol-metadata": "./dist/types/symbol-metadata.d.ts"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json && npm run build:assets",
		"build:assets": "mkdir -p dist/types && cp -R src/types/. dist/types/",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build --workspace @serve-tools/polyfill-decorator-metadata --workspace @serve-tools/polyfill-resource-management --workspace @serve-tools/polyfill-request-idle-callback && vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"@jsxtools/rolldown-transform": "^0.1",
		"@serve-tools/polyfill-decorator-metadata": "^0.1",
		"@serve-tools/polyfill-prioritized-task-scheduling": "^0.1",
		"@serve-tools/polyfill-request-idle-callback": "^0.1",
		"@serve-tools/polyfill-resource-management": "^0.1",
		"urlpattern-polyfill": "^10.1.0"
	},
	"peerDependencies": {
		"vite": "^8.2"
	}
}
