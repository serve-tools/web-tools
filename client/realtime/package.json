{
	"name": "@serve-tools/client-realtime",
	"version": "0.1.0",
	"description": "Sans-I/O typed request and subscription client core",
	"keywords": [
		"client",
		"realtime",
		"rpc",
		"sans-io",
		"subscription",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/realtime#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/realtime"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-realtime.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/realtime-protocol",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/realtime-protocol": "^0.1"
	}
}
