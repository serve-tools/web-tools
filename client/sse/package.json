{
	"name": "@serve-tools/client-sse",
	"version": "0.1.0",
	"description": "Typed requests and Fetch-streaming server-sent subscriptions",
	"keywords": [
		"fetch",
		"realtime",
		"rpc",
		"server-sent-events",
		"sse",
		"subscription",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/sse#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/sse"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-sse.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/realtime-protocol --workspace @serve-tools/client-realtime --workspace @serve-tools/server-realtime",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/client-realtime": "^0.1",
		"@serve-tools/realtime-protocol": "^0.1"
	}
}
