{
	"name": "@serve-tools/client-router",
	"version": "0.2.0",
	"description": "Typed browser routing built directly on the Navigation API",
	"keywords": [
		"browser",
		"client-side-routing",
		"navigation-api",
		"router",
		"single-page-application",
		"typescript",
		"view-transitions",
		"web-api",
		"web-platform"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/router#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/router"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-router.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"benchmark:types": "node benchmark/types.mjs",
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/router": "^0.2.0"
	}
}
