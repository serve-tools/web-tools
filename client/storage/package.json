{
	"name": "@serve-tools/client-storage",
	"version": "0.1.1",
	"description": "Observable access to local and session storage",
	"keywords": [
		"browser",
		"localstorage",
		"observable",
		"sessionstorage",
		"storage",
		"subscription",
		"web-storage"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/storage#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/storage"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-storage.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"dev": "cd demo && npm run dev",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
