{
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2025"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2025",
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/.*.ts", "vite.config.ts"],
	"references": [
		{
			"path": "../../db/tsconfig.json"
		},
		{
			"path": "../tsconfig.json"
		}
	]
}
