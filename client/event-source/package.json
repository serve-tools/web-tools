{
	"name": "@serve-tools/client-event-source",
	"version": "0.1.0",
	"description": "Typed JSON events over the native EventSource API",
	"keywords": [
		"eventsource",
		"json",
		"realtime",
		"server-sent-events",
		"sse",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/event-source#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/event-source"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-event-source.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
