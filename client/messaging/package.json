{
	"name": "@serve-tools/client-messaging",
	"version": "0.1.2",
	"description": "Requests and subscriptions across workers and message ports",
	"keywords": [
		"messagechannel",
		"messageport",
		"postmessage",
		"rpc",
		"sharedworker",
		"subscription",
		"transferable",
		"webworker"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/messaging#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/messaging"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-messaging.js",
		"./scope/*": "./dist/lib/scope/*.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"dev": "cd demo && vite",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
