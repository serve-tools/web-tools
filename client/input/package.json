{
	"name": "@serve-tools/client-input",
	"version": "0.1.1",
	"description": "Abortable pointer and drag-and-drop session observers for browser clients",
	"keywords": [
		"abortsignal",
		"drag-and-drop",
		"drop-target",
		"input",
		"pointer",
		"pointer-events",
		"typescript",
		"web-api"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/input#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/input"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-input.js",
		"./drop": "./dist/lib/drop.js",
		"./pointer": "./dist/lib/pointer.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
