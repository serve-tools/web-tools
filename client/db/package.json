{
	"name": "@serve-tools/client-db",
	"version": "0.1.0",
	"description": "Promise-based IndexedDB operations, transactions, and scans",
	"keywords": [
		"abortsignal",
		"async-iterator",
		"browser",
		"database",
		"indexeddb",
		"promise",
		"transaction",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/db#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/db"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-db.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"dev": "cd demo && npm run dev",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
