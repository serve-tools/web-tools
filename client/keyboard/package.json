{
	"name": "@serve-tools/client-keyboard",
	"version": "0.1.0",
	"description": "Platform-aware keyboard chords, labels, symbols, and ARIA shortcuts for browser clients",
	"keywords": [
		"accessibility",
		"aria-keyshortcuts",
		"hotkey",
		"keyboard",
		"platform",
		"shortcut",
		"typescript",
		"web-api"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client/keyboard#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client/keyboard"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/client-keyboard.js",
		"./lib/*": "./dist/lib/*.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "npm run clean && tsc --build --force tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
