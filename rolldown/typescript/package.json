{
	"name": "@serve-tools/rolldown-typescript",
	"version": "0.1.0",
	"description": "Compile and type-check TypeScript with Vite and Rolldown",
	"keywords": [
		"compile",
		"compiler",
		"compiling",
		"map",
		"maps",
		"project",
		"project-references",
		"references",
		"rolldown",
		"rolldown-plugin",
		"source",
		"source-map",
		"source-maps",
		"ts",
		"typescript",
		"vite",
		"vite-plugin"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/rolldown/typescript#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "rolldown/typescript"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/rolldown-typescript.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"devDependencies": {
		"rolldown": "1.2.7",
		"vite": "8.2.2"
	},
	"peerDependencies": {
		"rolldown": "^1.2.7",
		"typescript": "~7.1.0-0",
		"vite": "^8.2.2"
	},
	"peerDependenciesMeta": {
		"rolldown": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"engines": {
		"node": "^22.14.0 || >=24.0.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	}
}
