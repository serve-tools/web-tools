{
	"name": "@serve-tools/signal-db",
	"version": "0.1.0",
	"description": "Typed IndexedDB access with signal-backed reactive queries",
	"keywords": [
		"database",
		"indexeddb",
		"reactive",
		"signal",
		"storage",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client-signals/db#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client-signals/db"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/signal-db.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/client-db --workspace @serve-tools/signal --workspace @serve-tools/signal-effect",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && npm run build && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/client-db": "^0.1",
		"@serve-tools/signal": "^0.1",
		"@serve-tools/signal-effect": "^0.1"
	}
}
