{
	"name": "@serve-tools/signal-shared-event-source",
	"version": "0.1.0",
	"description": "SharedWorker EventSource clients with latest-event Signal state",
	"keywords": [
		"eventsource",
		"reactive",
		"server-sent-events",
		"sharedworker",
		"signal",
		"sse"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/client-signals/shared-event-source#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "client-signals/shared-event-source"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/signal-shared-event-source.js",
		"./scope/*": "./dist/scope/*.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/client-shared-event-source --workspace @serve-tools/signal-event-source",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && npm run build && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/client-shared-event-source": "^0.1",
		"@serve-tools/signal-event-source": "^0.1"
	}
}
