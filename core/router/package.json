{
	"name": "@serve-tools/router",
	"version": "0.2.0",
	"description": "Declares unnamed strongly typed routes shared across runtimes",
	"keywords": [
		"routing",
		"schema",
		"typescript",
		"url",
		"urlpattern",
		"web-platform"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/core/router#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "core/router"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/router.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"benchmark:types": "node benchmark/types.mjs",
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"devDependencies": {
		"@serve-tools/polyfill-urlpattern": "^0.1.0",
		"@serve-tools/ponyfill-urlpattern": "^0.1.1"
	}
}
