{
	"name": "@serve-tools/http-contract",
	"version": "0.1.0",
	"description": "Defines typed JSON HTTP contracts shared by native Fetch clients and validated handlers",
	"keywords": [
		"fetch",
		"http",
		"json",
		"openapi",
		"standard-schema",
		"typescript",
		"web-platform"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/core/http-contract#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "core/http-contract"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/http-contract.js",
		"./client": "./dist/client.js",
		"./server": "./dist/server.js",
		"./openapi": "./dist/openapi.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"benchmark:types": "node benchmark/types.mjs",
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/router": "^0.1.0",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@serve-tools/polyfill-urlpattern": "^0.1.0"
	}
}
