	"scripts": {
		"benchmark": "npm run benchmark --workspaces --if-present",
		"benchmark:client": "npm run benchmark --workspace @serve-tools/client-db --workspace @serve-tools/client-messaging --workspace @serve-tools/client-shared-db --workspace @serve-tools/client-shared-websocket --workspace @serve-tools/client-storage --workspace @serve-tools/client-websocket --workspace @serve-tools/signal-websocket",
		"benchmark:realtime": "npm run benchmark --workspace @serve-tools/realtime-protocol --workspace @serve-tools/client-messaging --workspace @serve-tools/client-websocket --workspace @serve-tools/client-shared-websocket --workspace @serve-tools/client-http-stream --workspace @serve-tools/client-webtransport --workspace @serve-tools/signal-websocket",
		"benchmark:skills": "node benchmark/skills/run.mjs",
		"benchmark:skills:ablation": "node benchmark/skills/agentic/run.mjs --suite ablation --runs 1 --seeds 13007,17011 --variants docs,current,minimal,helpers --concurrency 6",
		"benchmark:skills:ablation:accounting": "node benchmark/skills/agentic/ablation/accounting-smoke.mjs",
		"benchmark:skills:ablation:analyze": "node benchmark/skills/agentic/ablation/analyze.mjs",
		"benchmark:skills:ablation:preflight": "node benchmark/skills/agentic/ablation/preflight.mjs",
		"benchmark:skills:agentic": "node benchmark/skills/agentic/run.mjs",
		"benchmark:skills:agentic:analyze": "node benchmark/skills/agentic/analyze.mjs",
		"benchmark:skills:agentic:audit": "node benchmark/skills/agentic/quality-audit.mjs",
		"benchmark:skills:agentic:rescore": "node benchmark/skills/agentic/rescore.mjs",
		"benchmark:skills:transfer": "node benchmark/skills/agentic/run.mjs --suite transfer --seeds 7349,9811 --concurrency 6",
		"benchmark:skills:transfer:analyze": "node benchmark/skills/agentic/transfer/analyze.mjs",
		"benchmark:skills:transfer:preflight": "node benchmark/skills/agentic/transfer/preflight.mjs",
		"benchmark:typescript-adapter": "node scripts/typescript-adapter/benchmark.mjs",
		"build": "npm run build:typescript && npm run build:extras",
		"build:assets": "npm run build:assets --workspaces --if-present",
		"build:bundles": "npm run build:bundle --workspaces --if-present",
		"build:demos": "npm run typecheck:demos && npm run build:bundles",
		"build:extras": "npm run build:assets && npm run build:demos",
		"build:fresh": "npm run clean:build && npm run build",
		"build:pages": "node scripts/build-pages.mjs",
		"build:typescript": "tsc --build tsconfig.build.json --builders 4 --checkers 2",
		"build:typescript:clean": "tsc --build tsconfig.build.json --clean",
		"build:typescript-adapter": "node scripts/typescript-adapter/pilot.mjs --build",
		"check:packages": "node scripts/check-packages.mjs",
		"check:release": "node --test scripts/workspaces.test.mjs scripts/release-plan.test.mjs scripts/release-pack.test.mjs",
		"check:skill-ablation": "node --test benchmark/skills/agentic/ablation/*-tests.mjs",
		"check:skill-agentic": "node --test benchmark/skills/agentic/test/*.test.mjs && npm run check:skill-transfer && npm run check:skill-ablation",
		"check:skill-bench": "node --test benchmark/skills/test/*.test.mjs && node benchmark/skills/run.mjs --provider fixture --no-compile --quiet && npm run check:skill-agentic",
		"check:skill-transfer": "node --test benchmark/skills/agentic/transfer/*-tests.mjs",
		"check:skills": "node scripts/check-skills.mjs",
		"check:tsconfig-references": "node scripts/sync-tsconfig-references.mjs",
		"check:typescript-migration": "node --test scripts/typescript-migration/*.test.mjs",
		"check:unused": "knip --no-progress",
		"clean:build": "node scripts/clean-build.mjs",
		"dev:typescript-adapter": "node scripts/typescript-adapter/pilot.mjs",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"sync:pkg-versions": "node scripts/sync-pkg-versions.js",
		"sync:skill-recipes": "node scripts/check-skills.mjs --write-recipes",
		"sync:tsconfig-references": "node scripts/sync-tsconfig-references.mjs --write",
		"test": "npm run build:typescript && npm run test:node && npm run test:browser:consolidated",
		"test:browser:consolidated": "node scripts/run-browser-projects.mjs && vitest run --root client-signals/shared-db --config vitest.browser.config.ts && npm run test:browser --workspace @serve-tools/signal-dom",
		"test:node": "npm run test:node:vitest && npm run test:node:native && npm run test:node:coverage",
		"test:node:coverage": "npm run test:node --workspace @serve-tools/signal-dom",
		"test:node:native": "node --test polyfills/arraybuffer-base64/test/*.test.js ponyfills/arraybuffer-base64/test/*.test.js ponyfills/request-idle-callback/test/runtime/node.test.js core/http-contract-interop/test/interop.test.mjs",
		"test:node:vitest": "vitest run --config vitest.node.projects.config.ts",
		"test:typescript-adapter:browser": "node --test scripts/typescript-adapter/browser.test.mjs scripts/typescript-adapter/keyboard.test.mjs",
		"test:typescript-adapter:node": "node --test scripts/typescript-adapter/exports.test.mjs scripts/typescript-adapter/session.test.mjs scripts/typescript-adapter/plugin.test.mjs scripts/typescript-adapter/pilot.test.mjs scripts/typescript-adapter/watcher.test.mjs scripts/typescript-adapter/resolution.test.mjs",
		"typecheck": "npm run build:typescript && npm run typecheck:workspaces",
		"typecheck:demos": "npm run typecheck:local --workspaces --if-present",
		"typecheck:workspaces": "node scripts/typecheck-workspaces.mjs",
		"verify": "npm run verify:node && npm run test:browser:consolidated && npm run test:typescript-adapter:browser",
		"verify:node": "npm run lint && npm run check:unused && npm run format:check && npm run check:tsconfig-references && npm run typecheck && npm run test:node && npm run check:skills && npm run check:skill-bench && npm run check:release && npm run build:extras && npm run check:packages && npm run check:typescript-migration && npm run test:typescript-adapter:node"
	},
