{
	"name": "@serve-tools/web-tools",
	"version": "0.0.0",
	"private": true,
	"description": "Client libraries, polyfills, ponyfills, and Vite plugins",
	"homepage": "https://github.com/serve-tools/web-tools#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/serve-tools/web-tools.git"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal",
	"type": "module",
	"workspaces": [
		"client/*",
		"client/*/demo",
		"polyfill/*",
		"ponyfill/*",
		"vite/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check:packages": "npm run check:package --workspaces --if-present",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "npm run test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:packages"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.8",
		"@types/node": "26.2.0",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"dprint": "0.55.2",
		"playwright": "1.62.1",
		"publint": "0.3.23",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.14.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.5.1",
			"onFail": "error"
		}
	}
}
