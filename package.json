{
	"name": "web-tools-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Client libraries, polyfills, ponyfills, and Vite plugins",
	"homepage": "https://github.com/serve-tools/web-tools#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/serve-tools/web-tools.git"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal",
	"type": "module",
	"workspaces": [
		"client/context",
		"client/context/demo",
		"client/db",
		"client/db/demo",
		"client/input",
		"client/input/demo",
		"client/interaction",
		"client/interaction/demo",
		"client/keyboard",
		"client/keyboard/demo",
		"client/messaging",
		"client/messaging/demo",
		"client/shared-db",
		"client/shared-db/demo",
		"client/storage",
		"client/websocket",
		"client/client",
		"client/storage/demo",
		"client-signals/dom",
		"client-signals/dom/demo",
		"client-signals/event-target",
		"client-signals/messaging",
		"client-signals/shared-db",
		"client-signals/storage",
		"lit/signals",
		"lit/signals/demo",
		"polyfills/request-idle-callback",
		"polyfills/resource-management",
		"ponyfills/request-idle-callback",
		"ponyfills/resource-management",
		"signals/collections",
		"signals/effect",
		"signals/signal",
		"suite",
		"vite/polyfills"
	],
	"scripts": {
		"benchmark": "npm run benchmark --workspaces --if-present",
		"benchmark:client": "npm run benchmark --workspace @serve-tools/client-db --workspace @serve-tools/client-messaging --workspace @serve-tools/client-shared-db --workspace @serve-tools/client-storage --workspace @serve-tools/client-websocket",
		"build": "npm run build --workspaces --if-present",
		"build:pages": "node scripts/build-pages.mjs",
		"check:packages": "npm run check:package --workspaces --if-present",
		"check:skills": "node scripts/check-skills.mjs",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "npm run test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:skills && npm run build && npm run check:packages"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.8",
		"@playwright/test": "1.62.1",
		"@types/node": "26.2.0",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"dprint": "0.55.2",
		"playwright": "1.62.1",
		"publint": "0.3.23",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.14.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.5.1",
			"onFail": "error"
		}
	},
	"knip": {
		"ignoreExportsUsedInFile": true,
		"workspaces": {
			"client/client": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/context": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/input": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/interaction": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/keyboard": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client-signals/dom": {
				"entry": [
					"test/*.recipes.ts"
				],
				"ignoreUnresolved": [
					"/dom/signal-dom.js"
				]
			},
			"client-signals/event-target": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client-signals/messaging": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/db": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/messaging": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/shared-db": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/storage": {
				"entry": [
					"test/*.{recipes,types}.ts"
				]
			},
			"client/websocket": {
				"entry": [
					"benchmark/*.benchmark.ts",
					"test/*.{recipes,types}.ts"
				],
				"ignoreIssues": {
					"src/lib/.serialization.ts": [
						"exports"
					]
				}
			},
			"lit/signals": {
				"entry": [
					"src/{decorators,lit-signals}.ts",
					"test/*.{recipes,types}.ts"
				]
			},
			"client-signals/shared-db": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"client-signals/storage": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"polyfills/request-idle-callback": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"polyfills/resource-management": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"ponyfills/request-idle-callback": {
				"entry": [
					"src/ponyfill-request-idle-callback.ts",
					"test/*.recipes.ts"
				],
				"ignoreIssues": {
					"src/lib/.internals.ts": [
						"exports"
					]
				}
			},
			"ponyfills/resource-management": {
				"entry": [
					"src/ponyfill-resource-management.ts",
					"test/*.recipes.ts"
				]
			},
			"signals/collections": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"signals/effect": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"signals/signal": {
				"entry": [
					"test/*.recipes.ts"
				]
			},
			"vite/polyfills": {
				"entry": [
					"src/vite-polyfills.ts",
					"test/*.recipes.ts"
				],
				"ignoreDependencies": [
					"@serve-tools/polyfill-request-idle-callback",
					"@serve-tools/polyfill-resource-management",
					"urlpattern-polyfill"
				]
			}
		}
	}
}
