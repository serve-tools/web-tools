{
	"name": "@serve-tools/server-event-source",
	"version": "0.2.0",
	"description": "Fetch-compatible JSON Server-Sent Events",
	"keywords": [
		"event-source",
		"event-stream",
		"eventsource",
		"fetch",
		"json",
		"nodejs",
		"server",
		"server-sent-events",
		"sse",
		"typescript",
		"web-platform"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/server/event-source#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "server/event-source"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/server-event-source.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/polyfill-report-error",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/polyfill-report-error": "^0.1.1"
	}
}
