{
	"name": "@serve-tools/server-webtransport",
	"version": "0.1.0",
	"description": "Typed request, subscription, and datagram servers over WebTransport",
	"keywords": [
		"datagram",
		"node",
		"quic",
		"realtime",
		"rpc",
		"server",
		"webtransport"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/server/webtransport#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "server/webtransport"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/server-webtransport.js",
		"./runtime/*": "./dist/runtime/*.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsc --build --force tsconfig.json",
		"build:dependencies": "npm run build --workspace @serve-tools/realtime-protocol --workspace @serve-tools/server-realtime",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run build:dependencies && vitest run --config vitest.config.ts",
		"typecheck": "npm run build:dependencies && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@serve-tools/realtime-protocol": "^0.1",
		"@serve-tools/server-realtime": "^0.1"
	},
	"peerDependencies": {
		"@http3-server/server": "^0.3"
	},
	"peerDependenciesMeta": {
		"@http3-server/server": {
			"optional": true
		}
	}
}
