{
	"name": "@serve-tools/realtime-protocol",
	"version": "0.1.0",
	"description": "Binary structured values and typed realtime protocol messages",
	"keywords": [
		"binary",
		"protocol",
		"realtime",
		"rpc",
		"serialization",
		"stream",
		"structured-clone",
		"typescript"
	],
	"homepage": "https://github.com/serve-tools/web-tools/tree/main/realtime/protocol#readme",
	"bugs": {
		"url": "https://github.com/serve-tools/web-tools/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/serve-tools/web-tools.git",
		"directory": "realtime/protocol"
	},
	"license": "MIT-0",
	"author": "Jonathan Neal <jonathantneal@hotmail.com> (https://jonneal.dev)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/realtime-protocol.js",
		"./datagram": "./dist/datagram.js",
		"./datagram-registry": "./dist/datagram-registry.js",
		"./http-stream": "./dist/http-stream.js",
		"./stream": "./dist/stream.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"benchmark": "vitest run --config vitest.benchmark.config.ts",
		"build": "tsc --build tsconfig.json",
		"check:package": "publint && attw --pack . --profile esm-only",
		"clean": "rm -rf dist",
		"test": "npm run test:node && npm run test:browser",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:node": "vitest run --config vitest.config.ts",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
	}
}
